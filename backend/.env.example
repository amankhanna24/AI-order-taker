# Server
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL (create the database first in pgAdmin: CREATE DATABASE order_taker;)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/order_taker?schema=public"

# Language layer — free key: https://aistudio.google.com/app/apikey
# Leave GEMINI_API_KEY empty to use the deterministic fallback parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Protects menu/admin endpoints (send as x-admin-key). Use a long random string.
ADMIN_API_KEY=

# Restaurant used by the public ordering endpoints (slug created by the seed)
DEFAULT_RESTAURANT_SLUG=green-spoon-kitchen

# Directory for JSON error logs
LOG_DIR=logs
